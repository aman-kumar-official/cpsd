<?xml version="1.0" standalone="no"?>
<!DOCTYPE entity PUBLIC "-//UC Berkeley//DTD MoML 1//EN"
    "http://ptolemy.eecs.berkeley.edu/xml/dtd/MoML_1.dtd">
<entity name="Thermostat_FSM" class="ptolemy.actor.TypedCompositeActor">

    <!-- ================= DIRECTOR: 500 samples ================= -->
    <property name="SDF Director" class="ptolemy.domains.sdf.kernel.SDFDirector">
        <property name="iterations" value="500">
        </property>
        <property name="_location" class="ptolemy.kernel.util.Location" value="[90.0, 40.0]">
        </property>
    </property>

    <property name="Annotation" class="ptolemy.vergil.kernel.attributes.TextAttribute">
        <property name="text" class="ptolemy.kernel.util.StringAttribute" value="Three-state thermostat FSM (Heating / Normal / Cooling)&#10;Initial temp = 24 C, initial state = Heating&#10;Heating: +0.2 C/sample until 26 C -&gt; Normal&#10;Normal: held at 26 C, disturbance +0.5 C every 20 samples; temp &gt; 28 C -&gt; Cooling&#10;Cooling: -0.1 C/sample until 26 C -&gt; Normal&#10;State plot: 1 = Heating, 2 = Normal, 3 = Cooling">
        </property>
        <property name="_location" class="ptolemy.kernel.util.Location" value="[230.0, 15.0]">
        </property>
    </property>

    <!-- ================= DISTURBANCE: periodic +0.5 C pulse ================= -->
    <entity name="Disturbance" class="ptolemy.actor.lib.Pulse">
        <property name="indexes" value="{19}">
        </property>
        <property name="values" value="{0.5}">
        </property>
        <property name="repeat" value="true">
        </property>
        <property name="_location" class="ptolemy.kernel.util.Location" value="[100.0, 300.0]">
        </property>
    </entity>

    <!-- ================= THERMOSTAT FSM ================= -->
    <entity name="ThermostatFSM" class="ptolemy.domains.modal.kernel.FSMActor">
        <property name="_location" class="ptolemy.kernel.util.Location" value="[300.0, 200.0]">
        </property>
        <port name="temp" class="ptolemy.actor.TypedIOPort">
            <property name="input"/>
            <property name="_type" class="ptolemy.actor.TypeAttribute" value="double">
            </property>
        </port>
        <port name="rate" class="ptolemy.actor.TypedIOPort">
            <property name="output"/>
            <property name="_type" class="ptolemy.actor.TypeAttribute" value="double">
            </property>
        </port>
        <port name="state" class="ptolemy.actor.TypedIOPort">
            <property name="output"/>
            <property name="_type" class="ptolemy.actor.TypeAttribute" value="int">
            </property>
        </port>

        <entity name="Heating" class="ptolemy.domains.modal.kernel.State">
            <property name="isInitialState" value="true">
            </property>
            <property name="_location" class="ptolemy.kernel.util.Location" value="[100.0, 150.0]">
            </property>
        </entity>
        <entity name="Normal" class="ptolemy.domains.modal.kernel.State">
            <property name="_location" class="ptolemy.kernel.util.Location" value="[300.0, 150.0]">
            </property>
        </entity>
        <entity name="Cooling" class="ptolemy.domains.modal.kernel.State">
            <property name="_location" class="ptolemy.kernel.util.Location" value="[500.0, 150.0]">
            </property>
        </entity>

        <!-- Heating self-loop: keep heating -->
        <relation name="heatingStay" class="ptolemy.domains.modal.kernel.Transition">
            <property name="guardExpression" value="temp &lt; 25.99">
            </property>
            <property name="outputActions" value="rate = 0.2; state = 1">
            </property>
        </relation>
        <!-- Heating -> Normal at 26 C (snap exactly to 26) -->
        <relation name="heatingToNormal" class="ptolemy.domains.modal.kernel.Transition">
            <property name="guardExpression" value="temp &gt;= 25.99">
            </property>
            <property name="outputActions" value="rate = 26.0 - temp; state = 2">
            </property>
        </relation>
        <!-- Normal self-loop: hold temperature -->
        <relation name="normalStay" class="ptolemy.domains.modal.kernel.Transition">
            <property name="guardExpression" value="temp &lt;= 28.0">
            </property>
            <property name="outputActions" value="rate = 0.0; state = 2">
            </property>
        </relation>
        <!-- Normal -> Cooling when temp > 28 C -->
        <relation name="normalToCooling" class="ptolemy.domains.modal.kernel.Transition">
            <property name="guardExpression" value="temp &gt; 28.0">
            </property>
            <property name="outputActions" value="rate = -0.1; state = 3">
            </property>
        </relation>
        <!-- Cooling self-loop: keep cooling -->
        <relation name="coolingStay" class="ptolemy.domains.modal.kernel.Transition">
            <property name="guardExpression" value="temp &gt; 26.01">
            </property>
            <property name="outputActions" value="rate = -0.1; state = 3">
            </property>
        </relation>
        <!-- Cooling -> Normal at 26 C (snap exactly to 26) -->
        <relation name="coolingToNormal" class="ptolemy.domains.modal.kernel.Transition">
            <property name="guardExpression" value="temp &lt;= 26.01">
            </property>
            <property name="outputActions" value="rate = 26.0 - temp; state = 2">
            </property>
        </relation>

        <link port="Heating.outgoingPort" relation="heatingStay"/>
        <link port="Heating.incomingPort" relation="heatingStay"/>
        <link port="Heating.outgoingPort" relation="heatingToNormal"/>
        <link port="Normal.incomingPort" relation="heatingToNormal"/>
        <link port="Normal.outgoingPort" relation="normalStay"/>
        <link port="Normal.incomingPort" relation="normalStay"/>
        <link port="Normal.outgoingPort" relation="normalToCooling"/>
        <link port="Cooling.incomingPort" relation="normalToCooling"/>
        <link port="Cooling.outgoingPort" relation="coolingStay"/>
        <link port="Cooling.incomingPort" relation="coolingStay"/>
        <link port="Cooling.outgoingPort" relation="coolingToNormal"/>
        <link port="Normal.incomingPort" relation="coolingToNormal"/>
    </entity>

    <!-- ================= ROOM / PLANT COMPOSITE ACTOR ================= -->
    <!-- T(n+1) = T(n) + rate(n) + disturbance(n),  T(0) = 24 -->
    <entity name="RoomTemperature" class="ptolemy.actor.TypedCompositeActor">
        <property name="_location" class="ptolemy.kernel.util.Location" value="[300.0, 320.0]">
        </property>
        <port name="rate" class="ptolemy.actor.TypedIOPort">
            <property name="input"/>
            <property name="_location" class="ptolemy.kernel.util.Location" value="[40.0, 100.0]">
            </property>
        </port>
        <port name="disturbance" class="ptolemy.actor.TypedIOPort">
            <property name="input"/>
            <property name="_location" class="ptolemy.kernel.util.Location" value="[40.0, 160.0]">
            </property>
        </port>
        <port name="temp" class="ptolemy.actor.TypedIOPort">
            <property name="output"/>
            <property name="_location" class="ptolemy.kernel.util.Location" value="[480.0, 130.0]">
            </property>
        </port>
        <entity name="AddSubtract" class="ptolemy.actor.lib.AddSubtract">
            <property name="_location" class="ptolemy.kernel.util.Location" value="[180.0, 130.0]">
            </property>
        </entity>
        <entity name="TemperatureMemory" class="ptolemy.domains.sdf.lib.SampleDelay">
            <property name="initialOutputs" value="{24.0}">
            </property>
            <property name="_location" class="ptolemy.kernel.util.Location" value="[320.0, 130.0]">
            </property>
        </entity>
        <relation name="r1" class="ptolemy.actor.TypedIORelation">
        </relation>
        <relation name="r2" class="ptolemy.actor.TypedIORelation">
        </relation>
        <relation name="r3" class="ptolemy.actor.TypedIORelation">
            <vertex name="vertex1" value="[410.0, 130.0]">
            </vertex>
        </relation>
        <relation name="r4" class="ptolemy.actor.TypedIORelation">
        </relation>
        <link port="rate" relation="r1"/>
        <link port="AddSubtract.plus" relation="r1"/>
        <link port="disturbance" relation="r2"/>
        <link port="AddSubtract.plus" relation="r2"/>
        <link port="TemperatureMemory.output" relation="r3"/>
        <link port="AddSubtract.plus" relation="r3"/>
        <link port="temp" relation="r3"/>
        <link port="AddSubtract.output" relation="r4"/>
        <link port="TemperatureMemory.input" relation="r4"/>
    </entity>

    <!-- ================= PLOTTERS ================= -->
    <entity name="TemperaturePlot" class="ptolemy.actor.lib.gui.SequencePlotter">
        <property name="_location" class="ptolemy.kernel.util.Location" value="[560.0, 320.0]">
        </property>
        <configure>
<?plotml <!DOCTYPE plot PUBLIC "-//UC Berkeley//DTD PlotML 1//EN"
"http://ptolemy.eecs.berkeley.edu/xml/dtd/PlotML_1.dtd">
<plot>
<title>Thermostat Temperature vs Sample</title>
<xLabel>Sample number</xLabel>
<yLabel>Temperature (deg C)</yLabel>
<xRange min="0.0" max="500.0"/>
<yRange min="23.5" max="29.0"/>
</plot>?>
        </configure>
    </entity>
    <entity name="StatePlot" class="ptolemy.actor.lib.gui.SequencePlotter">
        <property name="_location" class="ptolemy.kernel.util.Location" value="[560.0, 200.0]">
        </property>
        <configure>
<?plotml <!DOCTYPE plot PUBLIC "-//UC Berkeley//DTD PlotML 1//EN"
"http://ptolemy.eecs.berkeley.edu/xml/dtd/PlotML_1.dtd">
<plot>
<title>Thermostat State (1=Heating, 2=Normal, 3=Cooling)</title>
<xLabel>Sample number</xLabel>
<yLabel>State</yLabel>
<xRange min="0.0" max="500.0"/>
<yRange min="0.5" max="3.5"/>
</plot>?>
        </configure>
    </entity>

    <!-- ================= TOP-LEVEL CONNECTIONS ================= -->
    <relation name="rateRel" class="ptolemy.actor.TypedIORelation">
    </relation>
    <relation name="distRel" class="ptolemy.actor.TypedIORelation">
    </relation>
    <relation name="tempRel" class="ptolemy.actor.TypedIORelation">
        <vertex name="vertex1" value="[450.0, 320.0]">
        </vertex>
    </relation>
    <relation name="stateRel" class="ptolemy.actor.TypedIORelation">
    </relation>

    <link port="ThermostatFSM.rate" relation="rateRel"/>
    <link port="RoomTemperature.rate" relation="rateRel"/>
    <link port="Disturbance.output" relation="distRel"/>
    <link port="RoomTemperature.disturbance" relation="distRel"/>
    <link port="RoomTemperature.temp" relation="tempRel"/>
    <link port="ThermostatFSM.temp" relation="tempRel"/>
    <link port="TemperaturePlot.input" relation="tempRel"/>
    <link port="ThermostatFSM.state" relation="stateRel"/>
    <link port="StatePlot.input" relation="stateRel"/>
</entity>
